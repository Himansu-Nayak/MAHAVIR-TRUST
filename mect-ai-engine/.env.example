# ==============================================================================
# MECT HIm Python AI Engine Configuration Template (.env.example)
# ==============================================================================
# Copy to .env in /opt/mect-ai-engine/ on the Hostinger VPS.
# Mode: Fail-Closed if INTERNAL_AI_SECRET is missing.

ENVIRONMENT=production
HOST=127.0.0.1
PORT=8082
CPU_THREADS=3
CONTEXT_WINDOW=2048

# Standardized Internal Authentication Secret (Shared with Next.js)
INTERNAL_AI_SECRET=your_high_entropy_internal_secret_here_min_32_chars

# Vector Database (Qdrant on Loopback)
QDRANT_URL=http://127.0.0.1:6333
COLLECTION_NAME=mect_knowledge_v1

# Model Weights Paths
MODEL_PATH=models/qwen2.5-3b-mect-q4_k_m.gguf
FALLBACK_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# Cloud Fallback (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

