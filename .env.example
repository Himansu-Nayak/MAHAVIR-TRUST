# ==============================================================================
# MAHAVIR TRUST - Frontend & AI Gateway Environment Template
# ==============================================================================
# Copy to .env.local for local Next.js development.
# NEVER commit production API keys, internal secrets, or database passwords to git.

# Public Institutional Backend Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# AI Gateway Architecture (Server-Side Only - Private)
AI_ENGINE_MODE=local_with_fallback
LOCAL_AI_CHAT_URL=http://127.0.0.1:8082/v1/chat/completions
LOCAL_AI_HEALTH_URL=http://127.0.0.1:8082/v1/health

# Standardized Internal Authentication Secret (Shared between Next.js & Python engine)
INTERNAL_AI_SECRET=your_high_entropy_internal_secret_here_min_32_chars

# Cloud Hot-Standby Fallback (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
